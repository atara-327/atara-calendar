# 手元の開発（wrangler dev）用の設定の例。.dev.vars にコピーして使う（.dev.vars は Git に入れない）。
# このファイルには、実際のメールアドレスなどを書かない。

# 'dev' のときだけ、Access の JWT の確認を省略する。手元には Access がないため。
# localhost か 127.0.0.1 で開いたときだけ効く（IP アドレスなど、ほかのホスト名では JWT を検証する）。
# 本番の設定には書かない（書かなければ、確認は省略されない）。
AUTH_MODE=dev

# ログインを許可するメールアドレス（AUTH_MODE=dev のときは使わない）
ALLOWED_EMAIL=

# 許可するサービストークンの Client ID（MCP を作るまでは空）
ALLOWED_SERVICE_TOKEN_ID=

# 通知の送り先の Discord Webhook の URL（実際の URL は書かない。知っていれば、誰でも、そのチャンネルに投稿できる）。
# 空のままなら、通知は送らず、通知の時刻だけが進む。
DISCORD_WEBHOOK_URL=

# 通知の文面のリンクの頭を差し替えるとき（本番の値は wrangler.jsonc の vars）。
# APP_ORIGIN=http://localhost:5173
