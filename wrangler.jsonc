{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atara-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  // calendar.ataraman.com の全体をこの Worker で配信する（Custom Domain。DNS と証明書は Cloudflare が作る）。
  // Access のアプリも同じドメインで作る（docs/setup.md の 3）。
  "routes": [{ "pattern": "calendar.ataraman.com", "custom_domain": true }],
  // Access の設定（秘密ではない）。Access のアプリを作ったあとに、実際の値を入れる。
  // ACCESS_TEAM_DOMAIN は <チーム名>.cloudflareaccess.com の形で書く（https:// や / は付けない）。
  // 空のままか、書式が違うと、Worker は API を拒否する（設定漏れで認証が素通りしないように）。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atara-calendar",
      // 仮の値。本番の D1 を作ったあと、実装 #5（デプロイ）で本物の id に差し替える。
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
