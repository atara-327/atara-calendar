{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atara-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  // Access の設定（秘密ではない）。Access のアプリを作ったあとに、実際の値を入れる。
  // 空のままだと、Worker は API を拒否する（設定漏れで認証が素通りしないように）。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
  },
}
