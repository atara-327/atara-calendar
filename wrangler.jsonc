{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atara-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-12",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": false,
  "preview_urls": false,
  // calendar.ataraman.com の全体をこの Worker で配信する（Custom Domain。DNS と証明書は Cloudflare が作る）。
  // Access のアプリも同じドメインで作る（docs/setup.md の 3）。
  "routes": [{ "pattern": "calendar.ataraman.com", "custom_domain": true }],
  // Access の設定（秘密ではない）。値の出どころは docs/setup.md の 2.1・3。
  // ACCESS_TEAM_DOMAIN は <チーム名>.cloudflareaccess.com の形で書く（https:// や / は付けない）。
  // 空のままか、書式が違うと、Worker は API を拒否する（設定漏れで認証が素通りしないように）。
  "vars": {
    "ACCESS_TEAM_DOMAIN": "ataraman.cloudflareaccess.com",
    "ACCESS_AUD": "91017dc6ea231374e8d3472e4268464d6481c5feb10f57155001dd9a24214454",
  },
  // Workers Logs。過去のログをダッシュボードで探せるようにする（設計書 付録A.3 の「ダッシュボードで探す」のため）。
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atara-calendar",
      "database_id": "54797379-d206-46c4-9197-0934ce8947a8",
      "migrations_dir": "migrations",
    },
  ],
}
